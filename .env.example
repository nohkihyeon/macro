# 시그널보드 환경 변수 예시 — 이 파일을 .env 로 복사해 필요한 값만 바꾸세요 (모두 선택)

# 서버 포트 / 브라우저 자동 오픈 끄기
# PORT=3000
# NO_OPEN=1

# 수집 주기(초): 한국 장중 / 장외 활성(미국장·환율) / 휴장·심야 / 일별 히스토리
# REFRESH_KR_OPEN=20
# REFRESH_ACTIVE=60
# REFRESH_CLOSED=300
# REFRESH_HISTORY=3600

# 마지막 접속 후 이 시간(초)이 지나면 업스트림 수집을 멈춤
# IDLE_AFTER=300

# 디스크 캐시 위치
# CACHE_DIR=./cache

# 위험 신호 임계값
# USDKRW_WARNING=1400
# VIX_WARNING=25
# VIX_DANGER=35
# CREDIT_PERCENTILE_WARNING=90
# FOREIGN_SELL_STREAK_WARNING=5

# 선택: KRX OpenAPI 인증키 — 설정하면 VKOSPI 지수(일별) 사용 (https://openapi.krx.co.kr)
# KRX_API_KEY=
